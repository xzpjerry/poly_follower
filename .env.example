# Public profile/proxy wallet used for follower position queries.
# Not required while simulate_empty_follower=true and execution.mode=dry-run.
FOLLOWER_PROFILE_WALLET=

# Authenticated modes accept file-backed credentials only. Never place secret
# values in this file. These paths normally point at /run/secrets/* in Docker.
POLYMARKET_PRIVATE_KEY_FILE=
POLYMARKET_CLOB_API_KEY_FILE=
POLYMARKET_CLOB_API_SECRET_FILE=
POLYMARKET_CLOB_API_PASSPHRASE_FILE=

# Optional non-secret Polygon RPC override used by the viem wallet client.
POLYGON_RPC_URL=https://polygon-rpc.com

# Live mode requires this non-secret value to exactly equal scope.event_slug.
POLYMARKET_LIVE_TRADING_EVENT=
