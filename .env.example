# Public profile/proxy wallet used for follower position queries.
# Not required while simulate_empty_follower=true and execution.mode=dry-run.
FOLLOWER_PROFILE_WALLET=

# Live execution is intentionally not implemented in the MVP.
# Never commit wallet private keys or CLOB credentials.
PRIVATE_KEY=
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=
